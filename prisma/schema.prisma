// =============================================================================
// RENTU — Hub Operativo de Propiedad Horizontal (ISIS2007 · Universidad de los Andes)
// Ruta destino: rentu-app/prisma/schema.prisma
// -----------------------------------------------------------------------------
// Decisiones de arquitectura relevantes (ver también "Evaluación del Juez"):
//   1. IDs UUID generados en la capa de aplicación (@default(uuid())) — no
//      requiere extensiones de PostgreSQL (pgcrypto/uuid-ossp) y es compatible
//      con entornos serverless (Vercel Functions).
//   2. Auditoría mínima obligatoria en TODA tabla: createdAt, updatedAt y
//      deletedAt (soft delete) — exigido por Skill 1 para preservar
//      trazabilidad legal bajo la Ley 675 de 2001.
//   3. Los registros financieros (CuentaDeCobro, RecargoMora, ComprobantePago)
//      y de convivencia (Pqrs) cuelgan de `Inmueble`, NUNCA directamente de
//      `Usuario` — así, al desvincular a un inquilino (HU-03) su historial
//      permanece íntegro y auditable sin importar qué pase con su cuenta.
//   4. `directUrl` se define junto a `url` para separar el pool de conexiones
//      (PgBouncer, usado en runtime) de la conexión directa que requiere
//      `prisma migrate` — evita agotar conexiones en Postgres en serverless.
//   5. Montos y coeficientes usan `Decimal`, nunca `Float`, para evitar
//      errores de redondeo en cartera (crítico en un dominio financiero).
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "relationJoins"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

// ----------------------------- ENUMS ----------------------------------------

enum RolUsuario {
  ADMINISTRADOR
  PROPIETARIO
  INQUILINO
}

enum RolEnInmueble {
  PROPIETARIO
  INQUILINO
}

enum EstadoInmueble {
  OCUPADO
  DESOCUPADO
}

enum EstadoCuenta {
  PENDIENTE
  PAGADA
  VENCIDA
  EN_MORA
}

enum EstadoComprobante {
  PENDIENTE_REVISION
  APROBADO
  RECHAZADO
}

enum TipoEvento {
  MANTENIMIENTO
  ASAMBLEA
  FUMIGACION
  LAVADO_TANQUES
  EMERGENCIA
  OTRO
}

enum TipoPQRS {
  PETICION
  QUEJA
  RECLAMO
  SUGERENCIA
  FALLA
}

enum EstadoPQRS {
  ABIERTO
  EN_PROCESO
  CERRADO
}

enum TipoDocumentoPH {
  REGLAMENTO_PH
  MANUAL_CONVIVENCIA
  ACTA_ASAMBLEA
  OTRO
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  CANCELADA
}

// Etapa de seguimiento de cobro de una unidad. Es una CLASIFICACIÓN DE
// GESTIÓN interna del administrador (la misma que usan los informes de
// cartera por antigüedad), NO una acción legal: PREJURIDICO y JURIDICO
// solo significan "este caso ya se escaló a ese seguimiento", nunca que
// Rentu inicie un proceso judicial ni preste asesoría legal.
enum EtapaCobro {
  AL_DIA
  RECORDATORIO
  COBRO_PERSUASIVO
  ACUERDO_PAGO
  PREJURIDICO
  JURIDICO
}

// Tipo de entrada en la bitácora de gestión de cobro de una unidad.
enum TipoGestionCobro {
  NOTA
  LLAMADA
  VISITA
  CAMBIO_ETAPA
  ACUERDO_PAGO
  AVISO_ENVIADO
}

// Canal por el que se "envió" un aviso de cobro. En el MVP ningún canal
// está integrado: `NotificacionCobro.simulada` es siempre true y la UI lo
// declara explícitamente.
enum CanalNotificacion {
  CORREO
  WHATSAPP
  CARTA
}

enum TipoPrestador {
  SEGURIDAD
  ASEO
  JARDINERIA
  MANTENIMIENTO
  OBRA
  PISCINA
  GIMNASIO
  OTRO
}

enum EstadoOrdenServicio {
  ABIERTA
  EN_PROCESO
  CERRADA
  CANCELADA
}

// --------------------------- IDENTIDAD Y RBAC -------------------------------

model Usuario {
  id           String     @id @default(uuid()) @db.Uuid
  nombre       String
  email        String     @unique
  passwordHash String
  telefono     String?
  rol          RolUsuario
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  copropiedadesAdministradas AdministradorCopropiedad[]
  vinculosInmuebles          UsuarioInmueble[]
  comprobantesCargados       ComprobantePago[]          @relation("ComprobanteCargadoPor")
  comprobantesRevisados      ComprobantePago[]          @relation("ComprobanteRevisadoPor")
  pagosRegistrados           Pago[]                     @relation("PagoRegistradoPor")
  documentosPHSubidos        DocumentoPH[]              @relation("DocumentoPHSubidoPor")
  comunicadosPublicados      Comunicado[]               @relation("ComunicadoPublicadoPor")
  lecturasComunicados        ComunicadoLectura[]
  pqrsRadicados              Pqrs[]                     @relation("PqrsRadicadoPor")
  pqrsAsignados              Pqrs[]                     @relation("PqrsAsignadoA")
  pqrsRespondidos            Pqrs[]                     @relation("PqrsRespondidoPor")
  pqrsDirigidas              Pqrs[]                     @relation("PqrsDirigidoA")
  reservasSolicitadas        Reserva[]                  @relation("ReservaSolicitadaPor")
  gestionesCobroRegistradas  GestionCobro[]             @relation("GestionCobroRegistradaPor")
  notificacionesCobroCreadas NotificacionCobro[]        @relation("NotificacionCobroCreadaPor")
  ordenesServicioCreadas     OrdenServicio[]            @relation("OrdenServicioCreadaPor")

  @@index([rol])
  @@map("usuarios")
}

model Copropiedad {
  id        String    @id @default(uuid()) @db.Uuid
  nombre    String
  nit       String?   @unique
  direccion String
  ciudad    String    @default("Bogotá D.C.")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  administradores AdministradorCopropiedad[]
  inmuebles       Inmueble[]
  mantenimientos  Mantenimiento[]
  comunicados     Comunicado[]
  documentosPH    DocumentoPH[]
  zonasComunes    ZonaComun[]
  prestadores     Prestador[]
  ordenesServicio OrdenServicio[]

  @@map("copropiedades")
}

// N:M explícita — un Administrador puede gestionar varias copropiedades
// (HU spec: "Gestiona múltiples copropiedades").
model AdministradorCopropiedad {
  id              String    @id @default(uuid()) @db.Uuid
  usuarioId       String    @db.Uuid
  copropiedadId   String    @db.Uuid
  fechaAsignacion DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  usuario     Usuario     @relation(fields: [usuarioId], references: [id])
  copropiedad Copropiedad @relation(fields: [copropiedadId], references: [id])

  @@unique([usuarioId, copropiedadId])
  @@map("administradores_copropiedad")
}

// ------------------------------ INMUEBLES -----------------------------------

model Inmueble {
  id            String         @id @default(uuid()) @db.Uuid
  copropiedadId String         @db.Uuid
  identificador String // p.ej. "Apto 101", "Casa 12"
  // Agrupador físico dentro de la copropiedad (torre, bloque o etapa). Es
  // el eje por el que el administrador lee la cartera ("¿qué torre
  // concentra la mora?"), así que se guarda como texto libre normalizado
  // por la aplicación en vez de una tabla aparte: una PH pequeña/mediana
  // tiene 1–6 torres y renombrarlas es más frecuente que relacionarlas.
  torre         String         @default("Torre 1")
  coeficiente   Decimal        @db.Decimal(7, 5) // coeficiente de copropiedad (Ley 675)
  areaM2        Decimal?       @db.Decimal(8, 2)
  estado        EstadoInmueble @default(OCUPADO)
  // Etapa de seguimiento de cobro. La cambia SIEMPRE el administrador de
  // forma explícita (queda registrada en `GestionCobro`); ningún job la
  // escala solo.
  etapaCobro    EtapaCobro     @default(AL_DIA)

  // --- DEPRECADO: campos del marketplace de arriendo -----------------------
  // El MVP dejó de ser un marketplace de arriendos (ver README). Estos
  // campos ya no se leen ni se escriben desde ninguna pantalla, Server
  // Action o seed; se conservan en el schema para no perder datos
  // existentes con una migración destructiva. Retirarlos requiere una
  // migración aparte, deliberada.
  disponibleArriendo  Boolean  @default(false)
  canonArriendo       Decimal? @db.Decimal(12, 2)
  habitaciones        Int?
  banos               Int?
  descripcionArriendo String?
  imagenUrl           String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  copropiedad         Copropiedad         @relation(fields: [copropiedadId], references: [id])
  residentes          UsuarioInmueble[]
  vehiculos           Vehiculo[]
  mascotas            Mascota[]
  cuentasDeCobro      CuentaDeCobro[]
  pqrs                Pqrs[]
  reservas            Reserva[]
  gestionesCobro      GestionCobro[]
  notificacionesCobro NotificacionCobro[]

  @@unique([copropiedadId, identificador])
  @@index([copropiedadId])
  @@index([copropiedadId, torre])
  @@index([etapaCobro])
  @@map("inmuebles")
}

// Padrón de ocupantes por unidad (HU-03). Se conserva SIEMPRE (nunca hard
// delete) para respetar la trazabilidad legal exigida por la Ley 675: al
// hacer offboarding de un inquilino solo se marca `activo = false` y se
// completa `fechaFin`.
model UsuarioInmueble {
  id          String        @id @default(uuid()) @db.Uuid
  usuarioId   String        @db.Uuid
  inmuebleId  String        @db.Uuid
  rol         RolEnInmueble
  fechaInicio DateTime      @default(now())
  fechaFin    DateTime?
  activo      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  usuario  Usuario  @relation(fields: [usuarioId], references: [id])
  inmueble Inmueble @relation(fields: [inmuebleId], references: [id])

  @@index([inmuebleId])
  @@index([usuarioId])
  @@map("usuario_inmueble")
}

model Vehiculo {
  id         String    @id @default(uuid()) @db.Uuid
  inmuebleId String    @db.Uuid
  placa      String
  tipo       String // carro, moto, bicicleta
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  inmueble Inmueble @relation(fields: [inmuebleId], references: [id])

  @@unique([inmuebleId, placa])
  @@map("vehiculos")
}

model Mascota {
  id         String    @id @default(uuid()) @db.Uuid
  inmuebleId String    @db.Uuid
  nombre     String
  especie    String
  raza       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  inmueble Inmueble @relation(fields: [inmuebleId], references: [id])

  @@map("mascotas")
}

// ------------------------------- CARTERA ------------------------------------

model CuentaDeCobro {
  id                  String       @id @default(uuid()) @db.Uuid
  inmuebleId          String       @db.Uuid
  periodo             String // formato "AAAA-MM", p.ej. "2026-09"
  montoAdministracion Decimal      @db.Decimal(12, 2)
  montoExpensas       Decimal      @default(0) @db.Decimal(12, 2)
  saldoAnterior       Decimal      @default(0) @db.Decimal(12, 2)
  totalAPagar         Decimal      @db.Decimal(12, 2)
  // Suma acumulada de `Pago.monto` aplicados a esta cuenta — se actualiza
  // dentro de la misma transacción que crea el Pago (ver Server Action
  // `registrarPago`). Cuando `montoPagado >= totalAPagar + recargos`, el
  // estado pasa a PAGADA.
  montoPagado         Decimal      @default(0) @db.Decimal(12, 2)
  fechaEmision        DateTime     @default(now())
  fechaLimitePago     DateTime
  estado              EstadoCuenta @default(PENDIENTE)
  urlPdf              String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?

  inmueble     Inmueble          @relation(fields: [inmuebleId], references: [id])
  recargosMora RecargoMora[]
  comprobantes ComprobantePago[]
  pagos        Pago[]

  @@unique([inmuebleId, periodo])
  @@index([estado])
  @@map("cuentas_de_cobro")
}

// Registro de dinero efectivamente recibido contra una cuenta de cobro
// (abono parcial o pago total). Distinto de `ComprobantePago`: ese modelo
// es la evidencia (PDF/imagen) que sube un residente y que el Administrador
// aprueba o rechaza; `Pago` es el movimiento de cartera ya conciliado, sea
// porque el Administrador lo registró manualmente o porque aprobó un
// comprobante.
model Pago {
  id              String    @id @default(uuid()) @db.Uuid
  cuentaDeCobroId String    @db.Uuid
  registradoPorId String    @db.Uuid
  monto           Decimal   @db.Decimal(12, 2)
  metodo          String    @default("Transferencia")
  observaciones   String?
  fechaPago       DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  cuentaDeCobro CuentaDeCobro @relation(fields: [cuentaDeCobroId], references: [id])
  registradoPor Usuario       @relation("PagoRegistradoPor", fields: [registradoPorId], references: [id])

  @@index([cuentaDeCobroId])
  @@map("pagos")
}

// HU-02: recargo por mora. `congelado = true` cuando existe un comprobante
// PENDIENTE_REVISION asociado a la cuenta — el job nocturno de mora NO debe
// aplicar/incrementar recargos sobre cuentas congeladas (regla de Skill 4).
model RecargoMora {
  id              String    @id @default(uuid()) @db.Uuid
  cuentaDeCobroId String    @db.Uuid
  monto           Decimal   @db.Decimal(12, 2)
  motivo          String    @default("Interés de Mora")
  fechaAplicacion DateTime  @default(now())
  congelado       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  cuentaDeCobro CuentaDeCobro @relation(fields: [cuentaDeCobroId], references: [id])

  @@index([cuentaDeCobroId])
  @@map("recargos_mora")
}

model ComprobantePago {
  id              String            @id @default(uuid()) @db.Uuid
  cuentaDeCobroId String            @db.Uuid
  cargadoPorId    String            @db.Uuid
  revisadoPorId   String?           @db.Uuid
  urlArchivo      String
  estado          EstadoComprobante @default(PENDIENTE_REVISION)
  fechaCarga      DateTime          @default(now())
  fechaRevision   DateTime?
  observaciones   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  cuentaDeCobro CuentaDeCobro @relation(fields: [cuentaDeCobroId], references: [id])
  cargadoPor    Usuario       @relation("ComprobanteCargadoPor", fields: [cargadoPorId], references: [id])
  revisadoPor   Usuario?      @relation("ComprobanteRevisadoPor", fields: [revisadoPorId], references: [id])

  @@index([cuentaDeCobroId])
  @@index([estado])
  @@map("comprobantes_pago")
}

// ------------------------ OPERACIÓN Y CONVIVENCIA ---------------------------

model Mantenimiento {
  id             String     @id @default(uuid()) @db.Uuid
  copropiedadId  String     @db.Uuid
  titulo         String
  descripcion    String?
  tipo           TipoEvento @default(MANTENIMIENTO)
  colorCategoria String     @default("#2563EB")
  esEmergencia   Boolean    @default(false) // omite reglas de anticipación (HU-04)
  fechaInicio    DateTime
  fechaFin       DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  copropiedad Copropiedad @relation(fields: [copropiedadId], references: [id])

  @@index([copropiedadId])
  @@index([fechaInicio])
  @@map("mantenimientos")
}

model Comunicado {
  id                  String    @id @default(uuid()) @db.Uuid
  copropiedadId       String    @db.Uuid
  publicadoPorId      String    @db.Uuid
  titulo              String
  contenido           String
  urlAdjunto          String?
  tamanioAdjuntoBytes Int? // validar <= 5MB en la capa de aplicación
  fechaPublicacion    DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  copropiedad  Copropiedad         @relation(fields: [copropiedadId], references: [id])
  publicadoPor Usuario             @relation("ComunicadoPublicadoPor", fields: [publicadoPorId], references: [id])
  lecturas     ComunicadoLectura[]

  @@index([copropiedadId])
  @@map("comunicados")
}

// Trazabilidad de lectura por usuario (HU-05: `fecha_hora_lectura`).
model ComunicadoLectura {
  id               String   @id @default(uuid()) @db.Uuid
  comunicadoId     String   @db.Uuid
  usuarioId        String   @db.Uuid
  fechaHoraLectura DateTime @default(now())

  comunicado Comunicado @relation(fields: [comunicadoId], references: [id])
  usuario    Usuario    @relation(fields: [usuarioId], references: [id])

  @@unique([comunicadoId, usuarioId])
  @@map("comunicado_lecturas")
}

model Pqrs {
  id                   String     @id @default(uuid()) @db.Uuid
  inmuebleId           String     @db.Uuid
  radicadoPorId        String     @db.Uuid
  asignadoAId          String?    @db.Uuid
  incidentePrincipalId String?    @db.Uuid
  respondidoPorId      String?    @db.Uuid
  // Residente hacia quien va dirigida la PQRS cuando quien la radica es el
  // Administrador (ver `crearPqrs` en src/lib/actions/pqrs.ts) — null cuando
  // es el propio residente quien la radica a nombre propio (`crearPqrsResidente`).
  dirigidoAId          String?    @db.Uuid
  codigoRadicado       String     @unique
  tipo                 TipoPQRS
  titulo               String
  descripcion          String
  urlFoto              String?
  estado               EstadoPQRS @default(ABIERTO)
  respuestaAdmin       String?
  respondidoEn         DateTime?
  fechaCierre          DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  deletedAt            DateTime?

  inmueble           Inmueble        @relation(fields: [inmuebleId], references: [id])
  radicadoPor        Usuario         @relation("PqrsRadicadoPor", fields: [radicadoPorId], references: [id])
  asignadoA          Usuario?        @relation("PqrsAsignadoA", fields: [asignadoAId], references: [id])
  respondidoPor      Usuario?        @relation("PqrsRespondidoPor", fields: [respondidoPorId], references: [id])
  dirigidoA          Usuario?        @relation("PqrsDirigidoA", fields: [dirigidoAId], references: [id])
  // Auto-relación para agrupar tickets duplicados bajo un "Incidente Principal" (HU-06).
  incidentePrincipal Pqrs?           @relation("AgrupacionIncidente", fields: [incidentePrincipalId], references: [id])
  ticketsAgrupados   Pqrs[]          @relation("AgrupacionIncidente")
  // Una PQRS de mantenimiento puede escalarse a una o más órdenes de
  // servicio hacia un prestador externo. Nunca es automático: lo decide el
  // administrador (ver `crearOrdenServicio`).
  ordenesServicio    OrdenServicio[]

  @@index([inmuebleId])
  @@index([estado])
  @@index([dirigidoAId])
  @@map("pqrs")
}

// --------------------- COPILOTO ADMINISTRATIVO (RAG) ------------------------
// Documentos de la copropiedad (reglamentos, manuales de convivencia, actas)
// indexados para responder preguntas del Administrador con contexto real.
// Los embeddings se generan LOCALMENTE con @xenova/transformers (sin API de
// pago) y se guardan en pgvector; el campo `embedding` es `Unsupported` porque
// Prisma Client no modela `vector` de forma nativa — toda lectura/escritura de
// `DocumentoPHChunk` pasa por SQL crudo ($queryRaw/$executeRaw), ver
// `src/lib/ai/`.

model DocumentoPH {
  id            String          @id @default(uuid()) @db.Uuid
  copropiedadId String          @db.Uuid
  subidoPorId   String          @db.Uuid
  tipo          TipoDocumentoPH
  titulo        String
  contenido     String // texto completo (pegado o extraído), fuente para re-indexar
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  copropiedad Copropiedad        @relation(fields: [copropiedadId], references: [id])
  subidoPor   Usuario            @relation("DocumentoPHSubidoPor", fields: [subidoPorId], references: [id])
  chunks      DocumentoPHChunk[]

  @@index([copropiedadId])
  @@map("documentos_ph")
}

model DocumentoPHChunk {
  id          String                     @id @default(uuid()) @db.Uuid
  documentoId String                     @db.Uuid
  indice      Int // orden del fragmento dentro del documento
  contenido   String
  // vector(384) — dimensión de Xenova/paraphrase-multilingual-MiniLM-L12-v2.
  embedding   Unsupported("vector(384)")
  createdAt   DateTime                   @default(now())

  documento DocumentoPH @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  @@index([documentoId])
  @@map("documento_ph_chunks")
}

// ------------------------ ZONAS COMUNES Y RESERVAS --------------------------

model ZonaComun {
  id            String    @id @default(uuid()) @db.Uuid
  copropiedadId String    @db.Uuid
  nombre        String // ej. "Salón social", "Zona BBQ", "Cancha múltiple"
  descripcion   String?
  aforo         Int
  costo         Decimal   @default(0) @db.Decimal(12, 2)
  activa        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  copropiedad Copropiedad @relation(fields: [copropiedadId], references: [id])
  reservas    Reserva[]

  @@index([copropiedadId])
  @@map("zonas_comunes")
}

// Regla de negocio (ver Server Action `crearReserva` / `actualizarEstadoReserva`
// en `src/lib/actions/reservas.ts`): un inmueble con cuentas de cobro en
// EN_MORA no puede solicitar ni confirmar reservas hasta ponerse a paz y salvo.
model Reserva {
  id              String        @id @default(uuid()) @db.Uuid
  zonaComunId     String        @db.Uuid
  inmuebleId      String        @db.Uuid
  solicitadaPorId String        @db.Uuid
  fechaInicio     DateTime
  fechaFin        DateTime
  estado          EstadoReserva @default(PENDIENTE)
  observaciones   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  zonaComun     ZonaComun @relation(fields: [zonaComunId], references: [id])
  inmueble      Inmueble  @relation(fields: [inmuebleId], references: [id])
  solicitadaPor Usuario   @relation("ReservaSolicitadaPor", fields: [solicitadaPorId], references: [id])

  @@index([zonaComunId])
  @@index([inmuebleId])
  @@index([fechaInicio])
  @@map("reservas")
}

// -------------------- GESTIÓN DE COBRO (BITÁCORA) ---------------------------
// Respuesta a "¿qué se ha hecho con este apartamento?". Es un registro
// append-only: una entrada por acción de cobro (nota, llamada, visita,
// cambio de etapa, acuerdo, aviso). Cuelga de `Inmueble` y no de `Usuario`
// para que el historial sobreviva al cambio de propietario o inquilino.
model GestionCobro {
  id              String           @id @default(uuid()) @db.Uuid
  inmuebleId      String           @db.Uuid
  registradoPorId String           @db.Uuid
  tipo            TipoGestionCobro @default(NOTA)
  etapaAnterior   EtapaCobro?
  etapaNueva      EtapaCobro?
  nota            String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  inmueble      Inmueble @relation(fields: [inmuebleId], references: [id])
  registradoPor Usuario  @relation("GestionCobroRegistradaPor", fields: [registradoPorId], references: [id])

  @@index([inmuebleId])
  @@index([createdAt])
  @@map("gestiones_cobro")
}

// Historial de avisos de cobro. ⚠️ `simulada` es `true` por defecto y en el
// MVP SIEMPRE vale true: no hay proveedor de correo/WhatsApp conectado, así
// que esto guarda la vista previa del mensaje que el administrador redactó,
// no un envío real. La UI lo rotula "Simulación MVP — no se envió correo
// real". Si algún día se integra un proveedor, ese envío guardará
// `simulada: false` y la UI podrá diferenciarlos sin migrar datos.
model NotificacionCobro {
  id            String            @id @default(uuid()) @db.Uuid
  inmuebleId    String            @db.Uuid
  creadoPorId   String            @db.Uuid
  canal         CanalNotificacion @default(CORREO)
  asunto        String
  cuerpo        String
  destinatarios String
  simulada      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?

  inmueble  Inmueble @relation(fields: [inmuebleId], references: [id])
  creadoPor Usuario  @relation("NotificacionCobroCreadaPor", fields: [creadoPorId], references: [id])

  @@index([inmuebleId])
  @@map("notificaciones_cobro")
}

// ------------------------ PRESTADORES Y ÓRDENES -----------------------------
// Prestadores externos (seguridad, aseo, jardinería, mantenimiento, obra,
// piscina, gimnasio). En este MVP NO inician sesión: son un directorio que
// administra el administrador, más las órdenes que les asigna.
model Prestador {
  id            String        @id @default(uuid()) @db.Uuid
  copropiedadId String        @db.Uuid
  nombre        String
  tipo          TipoPrestador @default(OTRO)
  contacto      String?
  telefono      String?
  email         String?
  notas         String?
  activo        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  copropiedad Copropiedad     @relation(fields: [copropiedadId], references: [id])
  ordenes     OrdenServicio[]

  @@unique([copropiedadId, nombre])
  @@index([copropiedadId])
  @@map("prestadores")
}

model OrdenServicio {
  id              String              @id @default(uuid()) @db.Uuid
  copropiedadId   String              @db.Uuid
  prestadorId     String              @db.Uuid
  creadoPorId     String              @db.Uuid
  // PQRS de origen cuando la orden nace de una solicitud de mantenimiento
  // de un residente. Null si el administrador la crea por su cuenta.
  pqrsId          String?             @db.Uuid
  titulo          String
  descripcion     String?
  estado          EstadoOrdenServicio @default(ABIERTA)
  fechaProgramada DateTime?
  costoEstimado   Decimal?            @db.Decimal(12, 2)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  copropiedad Copropiedad @relation(fields: [copropiedadId], references: [id])
  prestador   Prestador   @relation(fields: [prestadorId], references: [id])
  creadoPor   Usuario     @relation("OrdenServicioCreadaPor", fields: [creadoPorId], references: [id])
  pqrs        Pqrs?       @relation(fields: [pqrsId], references: [id])

  @@index([copropiedadId])
  @@index([prestadorId])
  @@index([estado])
  @@map("ordenes_servicio")
}
