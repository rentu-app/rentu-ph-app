# =============================================================================
# RENTU — Variables de entorno (plantilla)
# -----------------------------------------------------------------------------
# Copiar a `.env` y completar con credenciales reales.
# `.env` está en .gitignore: NUNCA commitees valores reales.
# =============================================================================

# --- Base de datos (Supabase Postgres / Neon) vía Prisma ---------------------
# Puerto 5432 del pooler = modo SESIÓN. Es el que debe usar la app en runtime.
#
# ⚠️ Evita el puerto 6543 (modo transacción + `pgbouncer=true`) salvo que el
# despliegue lo exija por límite de conexiones: en ese modo Prisma desactiva
# los prepared statements y envuelve CADA consulta en
# `BEGIN / DEALLOCATE ALL / SELECT / COMMIT` — 4 viajes de red donde debería
# haber 1. Medido desde Bogotá contra us-east-1: consulta simple 119 ms → 447 ms;
# carga de cartera 280 ms → 539 ms. Con ~6 consultas por pantalla eso son
# segundos de diferencia por navegación.
DATABASE_URL="postgresql://usuario:password@host:5432/postgres?connection_limit=5&pool_timeout=20"
# Cadena directa (sin pooling) — la usan `prisma db push` y el seed.
DIRECT_URL="postgresql://usuario:password@host:5432/postgres"

# --- Supabase (Auth) ---------------------------------------------------------
# El prefijo NEXT_PUBLIC_ expone el valor al navegador: el anon key es seguro
# de exponer, el service role NUNCA lleva ese prefijo.
NEXT_PUBLIC_SUPABASE_URL="https://<proyecto>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
SUPABASE_STORAGE_BUCKET="rentu-comprobantes"

# --- Aplicación --------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Copiloto Administrativo -------------------------------------------------
# Gemini (capa gratuita de Google AI Studio). Sin esta clave el resto de la app
# funciona; solo el chat del Copiloto devuelve error.
GEMINI_API_KEY="<api-key-de-google-ai-studio>"
